DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apd_detection

# JWT auth
SECRET_KEY=isi-dengan-string-acak-panjang
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=apd-violations

# Upload video
UPLOAD_DIR=storage/uploads
UPLOAD_EXPIRE_DAYS=30
MAX_UPLOAD_MB=500

# Inferensi AI
MODELS_DIR=storage/models
SNAPSHOT_DIR=storage/snapshots
PERSON_LABEL=person
INFERENCE_CONF=0.4
CONFIRM_FRAMES=3
VIOLATION_COOLDOWN_SECONDS=30
STATS_FLUSH_SECONDS=10

# Dashboard
DASHBOARD_TIMEZONE=Asia/Jakarta

# Sumber CCTV
CCTV_REGISTER_ADMIN_ONLY=false
VALIDATE_STREAM_ON_CREATE=true
STREAM_PROBE_TIMEOUT_SECONDS=8

# Sesi login (SRS 5.2: tidak aktif 30 menit = login ulang; frontend memanggil POST /auth/refresh)
SESSION_MAX_MINUTES=480

# Kuota dan retensi storage (0 = nonaktif)
STORAGE_QUOTA_MB=20480
SNAPSHOT_RETENTION_DAYS=90
HISTORY_RETENTION_DAYS=365
CLEANUP_INTERVAL_MINUTES=60
