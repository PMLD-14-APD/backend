# Salin ke deploy/.env lalu isi. File .env JANGAN di-commit.
BE_PORT=8000
FE_PORT=3000
DB_PORT=15432
# Buat acak, mis: python3 -c 'import secrets;print(secrets.token_hex(24))'
POSTGRES_PASSWORD=
